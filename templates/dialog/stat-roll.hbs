<div id="grimwild-roll-dialog" class="gw-roll">
	{{#if name}}
	<header class="gw-roll__who">
		{{#if img}}<img src="{{img}}" alt="" width="40" height="40">{{/if}}
		<div class="gw-roll__who-text">
			<strong>{{name}}</strong>
			<span>{{diceLabel}}</span>
		</div>
	</header>
	{{/if}}

	{{!-- Resumen: se lee de un vistazo. --}}
	<div class="gw-roll__totals" aria-live="polite">
		<div class="gw-total gw-total--dice" data-ayuda="dice">
			<span class="gw-total__num" data-total="dice">0</span>
			<span class="gw-total__label"><i class="fa-solid fa-dice-d6" inert></i> {{localize "GRIMWILD.Dice.dice"}}</span>
		</div>
		<div class="gw-total gw-total--thorns" data-ayuda="thorns">
			<span class="gw-total__num" data-total="thorns">0</span>
			<span class="gw-total__label"><i class="gw-icon-thorn" inert></i> {{localize "GRIMWILD.Dice.thorns"}}</span>
		</div>
	</div>
	<input type="hidden" name="totalDiceInput" value="0">
	<input type="hidden" name="totalThornsInput" value="0">

	<div class="gw-roll__cols">
		{{!-- Fuentes de dados --}}
		<fieldset class="gw-roll__src gw-roll__src--dice">
			<legend>{{localize "GRIMWILD.Dice.dice"}}</legend>
			<div class="gw-roll__row">
				<label for="gw-roll-stat">{{diceLabel}}</label>
				<div class="gw-stepper">
					<button type="button" data-action="step" data-target="stat" data-step="-1" aria-label="{{localize "GRIMWILD.UI.less"}}"><i class="fa-solid fa-minus" inert></i></button>
					<input type="number" id="gw-roll-stat" name="stat" value="{{diceDefault}}" min="0" data-dice>
					<button type="button" data-action="step" data-target="stat" data-step="1" aria-label="{{localize "GRIMWILD.UI.more"}}"><i class="fa-solid fa-plus" inert></i></button>
				</div>
			</div>
			<div class="gw-roll__row" data-ayuda="spark">
				<span class="gw-roll__label">{{localize "GRIMWILD.Actor.Character.FIELDS.spark.label"}}</span>
				{{#if hasSpark}}
				<div class="gw-pips">
					{{#each sparkArray}}
					<label class="gw-pip gw-pip--spark">
						<input type="checkbox" class="visually-hidden" name="spark{{this}}" data-spark>
						<i class="fa-solid fa-bolt" inert></i>
						<span class="visually-hidden">{{localize "GRIMWILD.Dialog.UseSpark"}}</span>
					</label>
					{{/each}}
				</div>
				{{else}}
				<span class="gw-roll__none">{{localize "GRIMWILD.UI.none"}}</span>
				{{/if}}
			</div>

			{{!-- Ayuda de otros personajes --}}
			<div class="gw-roll__assist" data-ayuda="assist">
				<span class="gw-roll__label">{{localize "GRIMWILD.Dice.assist"}}</span>
				{{#if helpers.length}}
				<div class="gw-roll__helpers">
					{{#each helpers}}
					<button type="button" class="gw-chip" data-action="addAssist" data-name="{{this}}"><i class="fa-solid fa-plus" inert></i> {{this}}</button>
					{{/each}}
				</div>
				{{/if}}
				<ul class="gw-roll__assists" data-assists></ul>
				<button type="button" class="gw-link" data-action="addAssist"><i class="fa-solid fa-user-plus" inert></i> {{localize "GRIMWILD.Dialog.OtherAssist"}}</button>
				<datalist id="assistants-list">
					{{#each assistants}}<option value="{{this}}"></option>{{/each}}
				</datalist>
			</div>
		</fieldset>

		{{!-- Fuentes de espinas --}}
		<fieldset class="gw-roll__src gw-roll__src--thorns">
			<legend>{{localize "GRIMWILD.Dice.thorns"}}</legend>
			<div class="gw-roll__toggles">
				<label class="gw-toggle gw-toggle--mark" data-ayuda="mark">
					<input type="checkbox" class="visually-hidden" name="marked" data-thorn {{checked isMarked}}>
					<i class="fa-solid fa-bookmark" inert></i> {{localize "GRIMWILD.Damage.marked"}}
				</label>
				<label class="gw-toggle gw-toggle--bloodied" data-ayuda="bloodied">
					<input type="checkbox" class="visually-hidden" name="bloodied" data-thorn {{checked isBloodied}}>
					<i class="fa-solid fa-droplet" inert></i> {{localize "GRIMWILD.Damage.bloodied"}}
				</label>
				<label class="gw-toggle gw-toggle--rattled" data-ayuda="rattled">
					<input type="checkbox" class="visually-hidden" name="rattled" data-thorn {{checked isRattled}}>
					<i class="fa-solid fa-brain" inert></i> {{localize "GRIMWILD.Damage.rattled"}}
				</label>
			</div>
			<div class="gw-roll__row" data-ayuda="conditions">
				<label for="gw-roll-conditions">{{localize "GRIMWILD.Damage.conditions"}}</label>
				<div class="gw-stepper">
					<button type="button" data-action="step" data-target="conditions" data-step="-1" aria-label="{{localize "GRIMWILD.UI.less"}}"><i class="fa-solid fa-minus" inert></i></button>
					<input type="number" id="gw-roll-conditions" name="conditions" value="{{conditions}}" min="0" data-thorns>
					<button type="button" data-action="step" data-target="conditions" data-step="1" aria-label="{{localize "GRIMWILD.UI.more"}}"><i class="fa-solid fa-plus" inert></i></button>
				</div>
			</div>
			<div class="gw-roll__row" data-ayuda="thorns">
				<label for="gw-roll-difficulty">{{localize "GRIMWILD.Dice.difficulty"}}</label>
				<div class="gw-stepper">
					<button type="button" data-action="step" data-target="difficulty" data-step="-1" aria-label="{{localize "GRIMWILD.UI.less"}}"><i class="fa-solid fa-minus" inert></i></button>
					<input type="number" id="gw-roll-difficulty" name="difficulty" value="0" min="0" data-thorns>
					<button type="button" data-action="step" data-target="difficulty" data-step="1" aria-label="{{localize "GRIMWILD.UI.more"}}"><i class="fa-solid fa-plus" inert></i></button>
				</div>
			</div>
		</fieldset>
	</div>
</div>
