{{#unless isPrivate}}
<section class="grimwild-chat grimwild-roll {{result}} stroke stroke-top">
  <div class="results">
    <h2>{{#if isCut }}
      {{localize (concat "GRIMWILD.Dice.results." rawResult)}} &#8594;
      {{/if}}
      {{localize (concat "GRIMWILD.Dice.results." result)}}</h2>
    {{#if stat}}<strong class="dice-stat">{{localize (concat "GRIMWILD.Stat." stat ".long")}}</strong>{{/if}}
    {{#if startPool}}
    <div class="pool-result">
      <strong>{{ startPool }} &#8594; {{ endPool }}</strong>
    </div>
    {{/if}}
    <div></div>
  </div>
  <div class="dice-tooltip expanded">
    <section class="tooltip-part">
      <div class="dice">
        <ul class="dice-rolls">
          {{#each dice as |die key|}}
            <li class="roll die d6 {{grimwildDie die.result}}">{{die.result}}</li>
          {{/each}}
        </ul>
        {{#each assists}}
          <ul class="dice-rolls">
            <span> &#8594; {{@key}}</span>
            {{#each this as |die key|}}
              <li class="roll die d6 {{grimwildDie die.result}}">{{die.result}}</li>
            {{/each}}
          </ul>
          {{/each}}
        <ul class="dice-rolls">
          {{#each thorns as |die key|}}
            <li class="roll die d8 {{grimwildThorn die.result}}">{{die.result}}</li>
          {{/each}}
        </ul>
      </div>
    </section>
  </div>
  <div class="action-links">
    {{#if isFail }}
    <div class="action-row action-marks flexrow">
      <strong>{{localize "GRIMWILD.UI.marks"}}</strong>
      <button data-action="applyMark" data-stat="bra">{{localize "GRIMWILD.Stat.bra.abbr"}}</button>
      <button data-action="applyMark" data-stat="agi">{{localize "GRIMWILD.Stat.agi.abbr"}}</button>
      <button data-action="applyMark" data-stat="wit">{{localize "GRIMWILD.Stat.wit.abbr"}}</button>
      <button data-action="applyMark" data-stat="pre">{{localize "GRIMWILD.Stat.pre.abbr"}}</button>
    </div>
    <div class="action-row action-harms flexrow">
      <strong>{{localize "GRIMWILD.UI.harm"}}</strong>
      <button data-action="applyHarm" data-harm="bloodied"><i class="fas fa-droplet"></i> {{localize "GRIMWILD.Damage.bloodied"}}</button>
      <button data-action="applyHarm" data-harm="rattled"><i class="fas fa-brain"></i> {{localize "GRIMWILD.Damage.rattled"}}</button>
    </div>
    {{/if}}
    <div class="action-row action-spark flexcol">
      <button data-action="updateSpark"><i class="fas fa-bolt"></i> {{localize "GRIMWILD.UI.takeSpark"}}</button>
      {{#if (eq result "disaster")}}
      <div class="spark-footnote"><em>{{localize "GRIMWILD.Dice.results.disaster"}}</em> {{localize "GRIMWILD.UI.grantSpark"}}</div>
      {{/if}}
    </div>
  </div>
</section>
{{/unless}}
