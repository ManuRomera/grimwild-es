<ol class="combat-tracker plain">
	{{#each turns as |turnsOfType type|}}
		<h2 class="combat-tracker-subtype">{{localize (concat "GRIMWILD.Actor.Plural." type)}}</h2>
		{{#if (eq type "character")}}
		<div class="combatant combatant-header">
			<div class="token-image"></div>
			<div class="token-name">{{localize "Name"}}</div>
			{{#if @root.tokenActions}}
				<div class="token-initiative">{{localize "GRIMWILD.Combat.TokenActions"}}</div>
			{{else}}
				<div class="token-initiative">{{localize "GRIMWILD.Combat.ActionCount"}}</div>
			{{/if}}
		</div>
		{{/if}}
		{{#each turnsOfType}}
			<li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">
				{{!-- TODO: Targets --}}

				{{!-- Image --}}
				<img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

				{{!-- Name & Controls --}}
				<div class="token-name">
					<strong class="name" title="{{ name }}">{{ name }}</strong>
					<div class="combatant-controls">
						{{#if @root.user.isGM}}
						<button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-dot gw-spotlight {{#if active}}active{{/if}}"
								data-action="spotlight" data-tooltip="{{ localize "GRIMWILD.Combat.SpotlightActor" }}" aria-label="{{ localize "GRIMWILD.Combat.SpotlightActor" }}" data-ayuda="spotlight"></button>
						<button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
								data-action="toggleHidden" data-tooltip aria-label="{{ localize "COMBAT.ToggleVis" }}"></button>
						<button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
								data-action="toggleDefeated" data-tooltip
								aria-label="{{ localize "COMBAT.ToggleDead" }}"></button>
						{{/if}}
						{{#if canPing}}
						<button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
								data-action="pingCombatant" data-tooltip
								aria-label="{{ localize "COMBAT.PingCombatant" }}"></button>
						{{/if}}
						{{#unless @root.user.isGM}}
						<button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
								data-action="panToCombatant" data-tooltip
								aria-label="{{ localize "COMBAT.PanToCombatant" }}"></button>
						{{/unless}}
						{{!-- TODO: Target Control --}}
						<div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
							{{#each effects.icons}}
							<img class="token-effect" src="{{ img }}" alt="{{ name }}">
							{{/each}}
						</div>
						{{#if (eq type "character")}}
						<div class="token-resources">
							<button type="button" class="inline-control resource resource-spark {{#if spark.value}}active{{/if}}" data-action="toggleSpark"
								data-tooltip="{{localize 'GRIMWILD.Actor.Character.FIELDS.spark.label'}}: {{spark.value}}/2"
								aria-label="{{localize 'GRIMWILD.Actor.Character.FIELDS.spark.label'}}: {{spark.value}}/2" data-ayuda="spark"
							><i class="fas fa-bolt" inert></i><span>{{spark.value}}</span></button>
							<button type="button" class="inline-control resource resource-bloodied {{#if bloodied.marked}}active{{/if}}" data-action="toggleHarm" data-harm="bloodied"
								aria-pressed="{{#if bloodied.marked}}true{{else}}false{{/if}}"
								data-tooltip="{{localize 'GRIMWILD.Damage.bloodied'}}" aria-label="{{localize 'GRIMWILD.Damage.bloodied'}}" data-ayuda="bloodied"
							><i class="fa-{{#if bloodied.marked}}solid{{else}}regular{{/if}} fa-droplet" inert></i>{{#if @root.enableHarmPools}}<span>{{bloodied.pool.diceNum}}</span>{{/if}}</button>
							<button type="button" class="inline-control resource resource-rattled {{#if rattled.marked}}active{{/if}}" data-action="toggleHarm" data-harm="rattled"
								aria-pressed="{{#if rattled.marked}}true{{else}}false{{/if}}"
								data-tooltip="{{localize 'GRIMWILD.Damage.rattled'}}" aria-label="{{localize 'GRIMWILD.Damage.rattled'}}" data-ayuda="rattled"
							><i class="fa-{{#if rattled.marked}}solid{{else}}regular{{/if}} fa-brain" inert></i>{{#if @root.enableHarmPools}}<span>{{rattled.pool.diceNum}}</span>{{/if}}</button>
						</div>
						{{/if}}
					</div>
				</div>

				{{!-- Resource --}}
				{{#if resource includeZero=true}}
				<div class="token-resource">
					<span class="resource">{{ resource }}</span>
				</div>
				{{/if}}

				{{!-- Initiative --}}
				<div class="token-initiative">
					{{#if (eq type "character")}}
					<span class="gw-actions" aria-label="{{#if @root.tokenActions}}{{localize "GRIMWILD.Combat.TokenActions"}}{{else}}{{localize "GRIMWILD.Combat.ActionCount"}}{{/if}}: {{actionCount}}">{{actionCount}}</span>
					{{/if}}
				</div>
			</li>
		{{/each}}
	{{/each}}
</ol>
