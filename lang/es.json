  "GRIMWILD": {
    "Settings": {
      "Grimwild": "Grimwild",
      "suspenseVisible": {
        "name": "Suspense visible para los jugadores",
        "hint": "Activa o desactiva esta opción para mostrar u ocultar el marcador de suspense a quienes no sean DJ."
      },
      "quickPoolsVisible": {
        "name": "Reservas rápidas visibles para los jugadores",
        "hint": "Activa o desactiva esta opción para mostrar u ocultar las reservas rápidas de la interfaz inferior a quienes no sean DJ."
      },
      "quickPoolsVisibleDefault": {
        "name": "Visibilidad predeterminada de las reservas rápidas",
        "hint": "Activa o desactiva esta opción para mostrar u ocultar las nuevas reservas rápidas por defecto."
      },
      "diceSoNiceOverride": {
        "name": "Usar siempre los dados 3D de Grimwild",
        "hint": "Ignora la configuración de Dice So Nice en las tiradas y reservas de Grimwild para usar el esquema de colores personalizado del sistema. Configuración de usuario."
      },
      "enableHarmPools": {
        "name": "[Casera] Activar reservas de daño en personajes",
        "hint": "Añade entradas de reserva a Ensangrentado y Alterado, de forma similar al texto de reglas de Grimwild v1.3."
      },
      "maxBloodied": {
        "name": "[Casera] Valor máximo de Ensangrentado",
        "hint": "Valor máximo para la entrada de Ensangrentado si las reservas de daño están activadas."
      },
      "maxRattled": {
        "name": "[Casera] Valor máximo de Alterado",
        "hint": "Valor máximo para la entrada de Alterado si las reservas de daño están activadas."
      },
      "slowXp": {
        "name": "PX lentos",
        "hint": "Activa esta opción para usar PX a mitad de ritmo, donde hacen falta dos marcas por cada casilla de PX."
      },
      "tokenActions": {
        "name": "[Variante] Iniciativa con fichas",
        "hint": "Activa la regla variante de <strong>Iniciativa con fichas</strong>, que da a cada jugador 2 fichas por \"ronda\" de combate o escena. Si no, se usará un contador sencillo de acciones realizadas."
      }
    },
