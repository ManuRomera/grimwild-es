      "text": {
        "format": 1,
        "content": "<p></p><table><thead><tr><td><p style=\"font-size:2rem\">NIVELES</p></td></tr></thead><tbody><tr><td><div class=\"page\" title=\"Page 40\"><div class=\"section\"><div class=\"layoutArea\"><div class=\"column\"><p><span style=\"font-family:'Capito04VAR'\"><strong>MOOK</strong><br/></span><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Mayormente solo </span><span style=\"font-family:'Capito04VARItalic'\"><em>vestirse</em></span><span style=\"font-family:'Capito04VAR'\">.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Una tirada de acción puede acabar con varios.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Los grupos grandes pueden ser una reserva de tarea.</span></p></div></div></div></div></td></tr><tr><td><div class=\"page\" title=\"Page 40\"><div class=\"section\"><div class=\"layoutArea\"><div class=\"column\"><p><span style=\"font-family:'Capito04VAR'\"><strong>DIFÍCIL</strong><br/></span><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Un enemigo típico y peligroso.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Una tirada de acción puede eliminar a uno de ellos.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Los grupos pequeños pueden ser una reserva de tarea.</span></p></div></div></div></div></td></tr><tr><td><div class=\"page\" title=\"Page 40\"><div class=\"section\"><div class=\"layoutArea\"><div class=\"column\"><p><span style=\"font-family:'Capito04VAR'\"><strong>ÉLITE</strong><br/></span><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Fuerte presencia en escena.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Un desafío 4d/6d.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">A menudo lidera un grupo de enemigos menores.</span></p></div></div></div></div></td></tr><tr><td><div class=\"page\" title=\"Page 40\"><div class=\"section\"><div class=\"layoutArea\"><div class=\"column\"><p><span style=\"font-family:'Capito04VAR'\"><strong>JEFE</strong><br/></span><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Domina la escena.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Un desafío 6d/8d o desafío vinculado.</span></p><p><span style=\"font-family:'SegoeUIEmoji'\">◆ </span><span style=\"font-family:'Capito04VAR'\">Extremadamente poderoso.</span></p></div></div></div></div></td></tr></tbody></table>"
